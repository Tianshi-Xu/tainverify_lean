/-! ## Helper lemmas -/

/-- `bw_sum` depends only on the shape of its second argument: if `x.shape = y.shape` then
    `bw_sum g x = bw_sum g y`. This is because `bw_sum` fills the output with `valAt g 0`
    regardless of the input values. -/
private theorem bw_sum_eq_of_shape_eq (g x y : Tensor) (h : x.shape = y.shape) :
    bw_sum g x = bw_sum g y := by
  cases x with | mk sx vx =>
  cases y with | mk sy vy =>
  simp only at h; subst h; rfl

