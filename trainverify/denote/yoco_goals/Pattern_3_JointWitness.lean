private def lookupShape (xs : List (Tid × Shape)) (tid : Tid) : Shape :=
  match xs.find? (fun p => p.1 = tid) with
  | some (_, sh) => sh
  | none => []

def shapeOfSM_P3 : Tid → Shape := lookupShape shapeOfSM_P3_list
def shapeOfPM_P3 : Tid → Shape := lookupShape shapeOfPM_P3_list

def isPinTid_P3 (tid : Tid) : Bool :=
  decide (tid = 5346) || decide (tid = 5395) || decide (tid = 5444) ||
  decide (tid = 5493) || decide (tid = 5542) || decide (tid = 5591) ||
  decide (tid = 5640) || decide (tid = 5689) || decide (tid = 5738) ||
  decide (tid = 5787) || decide (tid = 5836) || decide (tid = 5885)

/-- Custom StoreShapesHold via decidable list check (handles pin override). -/
theorem pinnedStore_shapes_hold_of_list (shapeOf : Tid → Shape)
    (envList : List (Tid × Shape))
    (h : envList.all (fun p =>
      if isPinTid_P3 p.1 then decide (cu_pin_value.shape = p.2)
      else decide ((shapeOf p.1) = p.2)) = true) :
    StoreShapesHold (pinnedStore isPinTid_P3 cu_pin_value shapeOf)
                    (shapeEnvOfList envList) := by
  intro tid sh hsh
  unfold shapeEnvOfList at hsh
  show (pinnedStore isPinTid_P3 cu_pin_value shapeOf tid).shape = sh
  unfold pinnedStore
  cases hf : envList.find? (fun p => p.1 = tid) with
  | none => rw [hf] at hsh; simp at hsh
  | some pair =>
    rw [hf] at hsh
    have hpair2 : pair.2 = sh := by simp at hsh; exact hsh
    have hmem : pair ∈ envList := List.mem_of_find?_eq_some hf
    have hkey : pair.1 = tid := by
      have := List.find?_some hf
      exact of_decide_eq_true this
    have hcheck := (List.all_eq_true.mp h) pair hmem
    by_cases hpin : isPinTid_P3 tid
    · rw [if_pos hpin]
      rw [← hkey] at hpin
      simp only [hpin, if_true] at hcheck
      have : cu_pin_value.shape = pair.2 := of_decide_eq_true hcheck
      rw [this, hpair2]
    · rw [if_neg hpin]
      show (zeroTensor (shapeOf tid)).shape = sh
      have hz : (zeroTensor (shapeOf tid)).shape = shapeOf tid := by
        unfold zeroTensor Tensor.mkShape; rfl
      rw [hz]
      rw [← hkey] at hpin
      simp only [hpin, if_false] at hcheck
      have hval : shapeOf pair.1 = pair.2 := of_decide_eq_true hcheck
      rw [hkey] at hval
      rw [hval, hpair2]

