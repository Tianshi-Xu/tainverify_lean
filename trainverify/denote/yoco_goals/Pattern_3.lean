    (initPM : Store) (tid_out in1 : Tid) (m : Nat) (node : NodeDecl)
    (f : Tensor → Tensor)
    (hsplit : pm_goal_3.nodes.take (m+1) = pm_goal_3.nodes.take m ++ [node])
    (hd1 : (pm_goal_3.nodes.drop (m+1)).all (fun n => !n.outs.isEmpty) = true)
    (hd2 : (pm_goal_3.nodes.drop (m+1)).all (fun n => !n.outs.contains tid_out) = true)
    (hz : node.op ≠ "OpName.FW_attn_zigzag")
    (hsw : node.op ≠ "OpName.FW_attn_sliding_window")
    (he1 : (pm_goal_3.nodes.drop m).all (fun n => !n.outs.isEmpty) = true)
    (he2 : (pm_goal_3.nodes.drop m).all (fun n => !n.outs.contains in1) = true)
    (happly : ∀ s : Store, applyNode pm_goal_3 s node tid_out = f (s in1)) :
    denoteGraph_ringAttn pm_goal_3 initPM tid_out
      = f (denoteGraph_ringAttn pm_goal_3 initPM in1) := by
  show pm_goal_3.nodes.foldl (applyNodeRingAttn pm_goal_3) initPM tid_out = _
  rw [foldl_prefix_eq_full_ringAttn pm_goal_3 pm_goal_3.nodes initPM tid_out (m+1) hd1 hd2,
      hsplit, List.foldl_append, List.foldl_cons, List.foldl_nil,
      applyNodeRingAttn_eq_applyNode_of_not_ring pm_goal_3 _ node hz hsw,
      happly,
      ← foldl_prefix_eq_full_ringAttn pm_goal_3 pm_goal_3.nodes initPM in1 m he1 he2]
  rfl

