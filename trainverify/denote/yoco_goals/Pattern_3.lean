theorem applyNode_fw_norm_linear_out
    (g : GraphDecl) (s : Store) (rank : Nat) (xTid wTid outTid : Tid) :
    applyNode g s { rank := rank, op := "OpName.FW_norm_linear", ins := [xTid, wTid], outs := [outTid] } outTid =
      fw_norm_linear (s xTid) (s wTid) := by
  unfold applyNode
  rw [show ([xTid, wTid] : List Tid).map s = [s xTid, s wTid] from rfl]
  change storeSet s [(outTid, fw_norm_linear (s xTid) (s wTid))] outTid = _
  unfold storeSet; simp [List.find?]

theorem applyNode_fw_multiref5_first_out
    (g : GraphDecl) (s : Store) (rank : Nat) (xTid t1 t2 t3 t4 t5 : Tid) :
    applyNode g s { rank := rank, op := "OpName.FW_multiref", ins := [xTid], outs := [t1, t2, t3, t4, t5], params := [5] } t1 = s xTid := by
  unfold applyNode
