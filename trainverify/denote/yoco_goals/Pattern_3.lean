    applyNode g s { rank := rank, op := "OpName.FW_multiref", ins := [xTid],
                    outs := outs, params := [n] } t = s xTid := by
  unfold applyNode
  subst hn
  rw [show ([xTid] : List Tid).map s = [s xTid] from rfl, evalOp_fw_multiref]
  exact storeSet_zip_replicate_mem s (s xTid) outs t hmem

