-- fw_view at the tensor's own shape is the identity.
theorem fw_view_id (t : Tensor) (sh : Shape) (h : t.shape = sh) :
    fw_view sh t = t := by
  apply Tensor.ext
  · show sh = t.shape; exact h.symm
  · intro idx hidx
    rw [valAt_fw_view sh t idx (by rw [h])]

