  have hSVA : (fw_view [2048, 512] (fw_swiglu (fw_view [2048, 512] (fw_linear (fw_view [2048, 1024] A) (initPM 5666))) (fw_view [2048, 512] (fw_linear (fw_view [2048, 1024] A) (initPM 5670))))).shape = [2048, 512] := fw_view_shape_eq _ _
