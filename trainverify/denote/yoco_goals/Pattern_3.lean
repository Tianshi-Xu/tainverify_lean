set_option maxHeartbeats 32000000 in
set_option maxRecDepth 20000 in
theorem sm_pm_moe_gmm_L1_commute
    (initSM initPM : Store)
    (h_ss_sm : StoreShapesHold initSM sm_goal_3InitEnv)
    (h_ss_pm : StoreShapesHold initPM pm_goal_3InitEnv)
    (hInit : InitGoalsHold pm_goal_3.numRanks goal_3_cut_initGoals initSM initPM) :
    denoteGraph_ringAttn sm_goal_3 initSM 4768
      = allGatherPrimDimN 0 2 0
          [denoteGraph_ringAttn pm_goal_3 initPM 7677,
           denoteGraph_ringAttn pm_goal_3 initPM 7678] := by
  -- unfold both sides
  rw [denote_sm_goal_3_4768, denote_pm_goal_3_7677, denote_pm_goal_3_7678]
  -- Bridge SM sub-terms to their PM/shard counterparts
  rw [denote_sm_goal_3_7471, denote_sm_goal_3_4763, denote_sm_goal_3_4764]
  rw [denote_pm_goal_3_11977, denote_pm_goal_3_11978,
      denote_pm_goal_3_11904,
      denote_pm_goal_3_7667, denote_pm_goal_3_7669,
