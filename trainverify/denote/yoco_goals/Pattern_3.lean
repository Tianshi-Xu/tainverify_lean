/-! ## Sub-obligations — 24 layer router commutes, isolated per layer.

    Each `sm_pm_router_commute_L{k}` is a self-contained lemma for layer k.
    Batch workers each own one file / one lemma. Once ALL 24 are proved,
    `sm_pm_router_commute_all` assembles them by `Fin.cases`.

    ALSO isolated: `sm_pm_router_shapes_r0`/`r1` cover the 24 shape claims
    per rank. Under the faithful reshape semantics these are 24 shape-
    reduction chains through fw_view / fw_linear / fw_add / rms_norm /
    per_head_mix_precision_linear / attn — routine but bulky. -/

namespace HsHelpersGeneric

/-! ## Generic hs-helper backbone lemmas

These four lemmas factor out the shared "back-substitution through the graph
prefix" skeleton used by every `RouterShapesHelpers.hs_<tid>` shape helper.
Each `hs_<tid>` reduces to one invocation plus a short op-specific shape step.
`foldl_prefix_eq_full_ringAttn` (defined above) is the only graph-fold lemma
they rely on. Proven with zero `sorry`; kernel axioms are the standard
`[propext, Classical.choice, Quot.sound]`. -/

set_option maxHeartbeats 4000000

/-- Leaf node: `tid` has no writer in the graph, so its denotation is the
    initial store value, whose shape is fixed by `StoreShapesHold`. -/
theorem denote_leaf_shape
    (initPM : Store) (hPM : StoreShapesHold initPM pm_goal_3InitEnv)
    (tid : Tid) (shape : Shape)
    (hd1 : (pm_goal_3.nodes.drop 0).all (fun n => !n.outs.isEmpty) = true)
    (hd2 : (pm_goal_3.nodes.drop 0).all (fun n => !n.outs.contains tid) = true)
    (hlk : pm_goal_3InitEnv tid = some shape) :
    (denoteGraph_ringAttn pm_goal_3 initPM tid).shape = shape := by
  have hleaf : denoteGraph_ringAttn pm_goal_3 initPM tid = initPM tid := by
    show pm_goal_3.nodes.foldl (applyNodeRingAttn pm_goal_3) initPM tid = _
    rw [foldl_prefix_eq_full_ringAttn pm_goal_3 pm_goal_3.nodes initPM tid 0 hd1 hd2]; rfl
  rw [hleaf]; exact hPM tid shape hlk

