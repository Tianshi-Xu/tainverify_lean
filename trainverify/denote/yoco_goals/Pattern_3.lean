    rw [reconstructWithDim_cons_cons_nonscalar 0 pm_goal_3.numRanks 0 (initPM 10081) (initPM 10082) []
        (by rw [h_ss_pm 10081 [32,1024,1024] (by decide)]; decide)] at hval
