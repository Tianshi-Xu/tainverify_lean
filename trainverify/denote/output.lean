def k_matmul_right_transpose (m n k : Nat) (a b : Tensor) : Fin (prodShape [m, n]) → Scalar :=
  fun outIdx =>
    let r := outIdx.1 / n
    let c := outIdx.1 % n
    ∑ j ∈ Finset.range k,
      (valAt a (r * k + j)) * (valAt b (j * n + c))

def k_matmul_left_transpose (m n k : Nat) (a b : Tensor) : Fin (prodShape [m, n]) → Scalar :=
  fun outIdx =>
    let r := outIdx.1 / n
    let c := outIdx.1 % n
    ∑ j ∈ Finset.range k,
      (valAt a (j * m + r)) * (valAt b (j * n + c))

